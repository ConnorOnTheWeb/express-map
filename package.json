{
  "name": "express-map",
  "displayName": "Express Map",
  "description": "Visual route, middleware, and template navigation for Express apps",
  "version": "1.0.1",
  "publisher": "connorontheweb",
  "license": "MIT",
  "icon": "media/express-map.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "express",
    "expressjs",
    "routes",
    "middleware",
    "templates",
    "nodejs",
    "visualization",
    "navigation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ConnorOnTheWeb/express-map"
  },
  "bugs": {
    "url": "https://github.com/ConnorOnTheWeb/express-map/issues"
  },
  "homepage": "https://github.com/ConnorOnTheWeb/express-map#readme",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:node_modules/express"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Express Map performs static analysis only and never executes user code."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "expressMap",
          "title": "Express Map",
          "icon": "media/express-map-icon.svg"
        }
      ]
    },
    "views": {
      "expressMap": [
        {
          "id": "expressMapTree",
          "name": "Express Map",
          "filterOnType": true
        }
      ]
    },
    "commands": [
      {
        "command": "expressMap.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Express Map"
      },
      {
        "command": "expressMap.copyRoutePath",
        "title": "Copy Route Path",
        "icon": "$(copy)",
        "category": "Express Map"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "expressMap.refresh",
          "when": "view == expressMapTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "expressMap.copyRoutePath",
          "when": "view == expressMapTree && viewItem =~ /^route/",
          "group": "inline@1"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "express-map_analyzeApp",
        "tags": ["express", "routes", "api", "templates", "middleware"],
        "displayName": "Express Map: App Analysis",
        "modelDescription": "Returns a structured summary of the Express.js application in the current workspace: all routes (method, path, file, line, template rendered, async flag, error handling), templates, broken template references (res.render calls pointing to missing files), async handlers without try/catch, duplicate routes, orphaned templates never referenced by any route, and global middleware. Use this when the user asks about their Express app's routing structure, API endpoints, template usage, or potential issues.",
        "canBeReferencedInPrompt": false,
        "icon": "$(map)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0"
  }
}
